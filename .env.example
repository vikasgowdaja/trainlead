# Local configuration template. Never commit a populated .env file.
# These values must be loaded into the server process environment.

# WATI V3 API base URL from your WATI dashboard.
WATI_API_BASE_URL=https://live-mt-server.wati.io/api/ext/v3/

# Enter the full WATI API token locally, without the "Bearer " prefix.
# A token does not grant access to groups or channels outside your account permissions.
WATI_API_TOKEN=

# Optional: required for live Claude extraction, not for WATI API authentication.
# Keep blank until you enable external AI processing of messages.
ANTHROPIC_API_KEY=

# Override with a model available in your Anthropic account if necessary.
CLAUDE_MODEL=claude-sonnet-5-5